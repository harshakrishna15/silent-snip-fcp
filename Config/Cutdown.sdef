<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="Cutdown Share Terminology">
  <suite name="Cutdown Asset Management" code="pvam" description="Receive project XML and rendered audio from Final Cut Pro.">
    <command name="open" code="aevtodoc" description="Complete an exported asset delivery.">
      <cocoa class="CutdownShareOpenCommand"/>
      <access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
      <access-group identifier="com.apple.assetmanagement.import" access="rw"/>
      <direct-parameter><type type="file"/><type type="file" list="yes"/></direct-parameter>
    </command>
    <command name="get" code="coregetd"><cocoa class="NSGetCommand"/>
      <access-group identifier="com.apple.proapps.assetmanagement.import" access="r"/>
      <access-group identifier="com.apple.assetmanagement.import" access="r"/>
      <direct-parameter type="specifier"/><result type="any"/>
    </command>
    <command name="make" code="corecrel" description="Prepare a new share export.">
      <cocoa class="CutdownShareMakeCommand"/>
      <access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
      <access-group identifier="com.apple.assetmanagement.import" access="rw"/>
      <parameter name="new" code="kocl" type="type"><cocoa key="ObjectClass"/></parameter>
      <parameter name="at" code="insh" type="location specifier" optional="yes"><cocoa key="Location"/></parameter>
      <parameter name="with data" code="data" type="any" optional="yes"><cocoa key="ObjectData"/></parameter>
      <parameter name="with properties" code="prdt" type="record" optional="yes"><cocoa key="KeyDictionary"/></parameter>
      <result type="specifier"/>
    </command>
    <class name="application" code="capp" description="Cutdown application.">
      <cocoa class="NSApplication"/>
      <access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
      <access-group identifier="com.apple.assetmanagement.import" access="rw"/>
      <property name="name" code="pnam" type="text" access="r"/>
      <element type="asset" access="r"><cocoa key="cutdownShareAssets"/>
        <access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
        <access-group identifier="com.apple.assetmanagement.import" access="rw"/>
      </element>
    </class>
    <record-type name="asset location" code="aslc">
      <property name="folder" code="asfd" type="file"><cocoa key="folder"/></property>
      <property name="base name" code="asbn" type="text"><cocoa key="basename"/></property>
      <property name="has media" code="ashm" type="boolean"><cocoa key="hasMedia"/></property>
      <property name="has description" code="ashd" type="boolean"><cocoa key="hasDescription"/></property>
    </record-type>
    <record-type name="library location" code="lblc">
      <property name="library folder" code="lbfd" type="file"><cocoa key="folder"/></property>
      <property name="library base name" code="lbbn" type="text"><cocoa key="basename"/></property>
      <property name="has archive" code="lbha" type="boolean"><cocoa key="hasArchive"/></property>
      <property name="has library description" code="lbhd" type="boolean"><cocoa key="hasDescription"/></property>
    </record-type>
    <value-type name="user defined record" code="usrf"><cocoa class="NSDictionary"/></value-type>
    <class name="asset" code="aset" description="One pending or completed share export.">
      <cocoa class="CutdownShareAsset"/>
      <access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
      <access-group identifier="com.apple.assetmanagement.import" access="rw"/>
      <property name="id" code="ID  " type="text" access="r"><cocoa key="uniqueID"/></property>
      <property name="name" code="pnam" type="text" access="r"><cocoa key="name"/></property>
      <property name="location info" code="locn" type="asset location" access="r"><cocoa key="locationInfo"/></property>
      <property name="library info" code="lbry" type="library location" access="r"><cocoa key="libraryInfo"/></property>
      <property name="metadata" code="meta" type="user defined record" access="rw"><cocoa key="metadata"/></property>
      <property name="data options" code="dopt" type="user defined record" access="rw"><cocoa key="dataOptions"/></property>
    </class>
  </suite>
</dictionary>
